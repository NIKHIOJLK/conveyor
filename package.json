{
  "name": "conveyor",
  "version": "1.0.0",
  "description": "A reliable background job queue built on PostgreSQL: retries with backoff, dead-letter queue, crash recovery, rate limits and a live dashboard.",
  "type": "module",
  "license": "MIT",
  "author": "Nikhil Sharma",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "tsx src/db/migrate.ts",
    "api": "tsx src/api/index.ts",
    "worker": "tsx src/worker.ts",
    "worker:http": "tsx src/http-worker.ts",
    "load": "tsx src/demo/load.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "dev": "tsx watch src/api/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/worker.js",
    "start:http-worker": "node dist/http-worker.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
