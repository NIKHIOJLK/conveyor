# Copy this file to .env and edit the password to match your local PostgreSQL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/conveyor

# Used by `npm test` (a separate database, wiped by the tests)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/conveyor_test

PORT=3000
# Allow the dashboard's "add demo jobs" buttons (turn off in production)
DEMO_MODE=true

# HTTP task worker (npm run worker:http): job "send-ticket-email" is POSTed to {TASKS_URL}/send-ticket-email
TASKS_URL=http://localhost:8080/internal/tasks
TASKS_SECRET=change-me-to-a-long-random-string
